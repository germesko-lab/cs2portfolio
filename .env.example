# --- Price/data source configuration -----------------------------------
# unset/'auto' (default): REAL prices - Skinport's public API needs no key;
#         CSFloat/CSGOSKINS additionally activate when their keys are set.
# 'mock': deterministic offline demo prices only (local dev without network,
#         tests). Real and mock sources are never mixed.
PRICE_SOURCE_MODE=

# REAL_KEY_REQUIRED - CSFloat API key (csfloat.com profile -> Developers tab).
# Used by src/lib/prices/csfloat.ts as the Authorization header.
CSFLOAT_API_KEY=

# REAL_KEY_REQUIRED - CSGOSKINS.GG Pricing API key (partner/business plan).
# Used by src/lib/prices/csgoskins.ts.
CSGOSKINS_API_KEY=

# --- "Sign in through Steam" (OpenID) -----------------------------------
# Public base URL of the deployed site - used as the OpenID realm/return URL.
# Optional: on Railway, RAILWAY_PUBLIC_DOMAIN is auto-detected; elsewhere the
# request origin is used. Set explicitly to pin it down (recommended in prod).
APP_BASE_URL=

# REAL_KEY_REQUIRED - Steam Web API key (steamcommunity.com/dev/apikey).
# ONLY needed to resolve vanity /id/{name} profile URLs; numeric IDs,
# /profiles/ URLs and trade offer links work without it. Governed by the
# Steam Web API Terms of Use (LEGAL.md). STEAM_WEB_API_KEY is a legacy alias.
STEAM_API_KEY=
