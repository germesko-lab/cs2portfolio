# --- Price/data source configuration -----------------------------------
# 'mock' (default): app runs fully on bundled realistic mock data, no keys.
# 'live': real adapters are used for any source whose key is present;
#         sources without keys are skipped gracefully.
PRICE_SOURCE_MODE=mock

# REAL_KEY_REQUIRED — CSFloat API key (csfloat.com profile → Developers tab).
# Used by src/lib/prices/csfloat.ts as the Authorization header.
CSFLOAT_API_KEY=

# REAL_KEY_REQUIRED — CSGOSKINS.GG Pricing API key (partner/business plan).
# Used by src/lib/prices/csgoskins.ts.
CSGOSKINS_API_KEY=

# Default inventory to sync when the dashboard field is left empty and no
# input is posted. Any form the UI accepts works (SteamID64 / profile URL /
# trade offer URL). Unset => the bundled demo fixture is used.
STEAM_ID=

# REAL_KEY_REQUIRED — Steam Web API key (steamcommunity.com/dev/apikey).
# ONLY needed to resolve vanity /id/{name} profile URLs; numeric IDs,
# /profiles/ URLs and trade offer links work without it. Governed by the
# Steam Web API Terms of Use (LEGAL.md). STEAM_WEB_API_KEY is a legacy alias.
STEAM_API_KEY=
